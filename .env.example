# =============================================================================
# FSSAI Label Compliance Check Service — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME="FSSAI Label Compliance Check Service"
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/compliance.db

# --- LLM Provider ---
LLM_PROVIDER=gemini          # gemini | openai | mock (mock only for tests/demo)
GEMINI_API_KEY=               # Required for Gemini vision and reasoning
OPENAI_API_KEY=               # Required if LLM_PROVIDER=openai
OPENAI_API_BASE=              # Optional: custom endpoint for OpenAI-compatible APIs
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.8-flash

# --- LLM Resilience ---
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60
LLM_MOCK_FALLBACK=false       # Never silently use mock answers in real evaluations/deployments

# --- RAG / Vector Store ---
CHROMA_PERSIST_DIR=./data/vectorstore
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_MIN_SCORE=0.3
REGULATORY_REQUIRE_AUTHORITATIVE_CORPUS=true
REGULATORY_AUTHORIZED_SHA256_JSON={} # Filename-to-SHA256 map; only independently verified PDFs may be allowlisted

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE_MB=10

# --- Vision Provider (Stage 0) ---
VISION_PROVIDER=gemini        # gemini | openai | mock (mock only for tests/demo)
GEMINI_VISION_MODEL=gemini-3.8-flash
OPENAI_VISION_MODEL=gpt-4o-mini
EXTRACTION_CONFIDENCE_THRESHOLD=0.80
UPLOAD_MAX_IMAGES=4
UPLOAD_MAX_SIZE_MB=5
UPLOAD_RETENTION_DAYS=7

# --- Expert Authentication ---
EXPERT_API_KEY=               # Optional single expert key
EXPERT_API_KEYS_JSON={}       # Optional JSON map of raw key to expert_id/name/role; keep secrets outside source control

# --- Metrics ---
ENABLE_PROMETHEUS=true

# --- Docker / Deployment ---
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
